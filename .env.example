# Build-time settings for the v2 build on Cloudflare Workers (never commit real secrets).
# Set them in the GitHub Actions workflow (.github/workflows/v2.yml) or your shell; all optional, defaults are built in.
NEXT_PUBLIC_SITE_URL=https://stephencorporateservices-scs.com
# Discovery Call booking page (Cal.com). Every "Book" call to action opens it in a new tab.
# The same URL is the built-in default in src/lib/site.ts, so an empty value never breaks the buttons.
NEXT_PUBLIC_BOOKING_URL=https://cal.com/support-stephen-corporate-services-scs/30min
# Only the production deploy sets this; every other build is noindex.
# NEXT_PUBLIC_SITE_ENV=production
# Preview-only flags (set by the v2 workflow for preview builds). Leave UNSET in production.
# NEXT_PUBLIC_SHOW_CLIENT_PLACEHOLDERS=true
# NEXT_PUBLIC_ENABLE_PORTAL_PROTOTYPE=true
#
# Worker secrets (Cloudflare dashboard or `npx wrangler secret put NAME`), never in this file:
#   ADMIN_USER, ADMIN_PASSWORD   /admin password gate
