# Set in Netlify: Site configuration → Environment variables (never commit real secrets).
# All optional — sensible defaults are built in.
NEXT_PUBLIC_SITE_URL=https://stephencorporateservices-scs.com
# Discovery Call booking page (Cal.com). Every "Book" call to action opens it in a new tab.
# The same URL is the built-in default in src/lib/site.ts, so an empty value never breaks the buttons.
NEXT_PUBLIC_BOOKING_URL=https://cal.com/support-stephen-corporate-services-scs/30min
# Preview-only flags (already set for deploy previews / branch deploys in netlify.toml). Leave UNSET in production.
# NEXT_PUBLIC_SHOW_CLIENT_PLACEHOLDERS=true
# NEXT_PUBLIC_ENABLE_PORTAL_PROTOTYPE=true
